<?xml version="1.0" encoding="utf-8"?><!--
   Used on devices older than API 31; newer devices use data_extraction_rules.xml.
   Session tokens and account state must never leave the device in a backup.
-->
<full-backup-content>
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="secure_prefs.xml"/>
   <exclude domain="sharedpref" path="reportamelo_app_preferences.xml"/>
</full-backup-content>
