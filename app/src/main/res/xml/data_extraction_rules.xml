<?xml version="1.0" encoding="utf-8"?><!--
   Used on API 31+. Session tokens and account state must never leave the device
   in a cloud backup or a device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_prefs.xml"/>
        <exclude domain="sharedpref" path="reportamelo_app_preferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml"/>
        <exclude domain="sharedpref" path="reportamelo_app_preferences.xml"/>
    </device-transfer>
</data-extraction-rules>
